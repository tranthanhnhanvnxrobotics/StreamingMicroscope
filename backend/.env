AUTOFOCUS_FINE_SETTLE_MS=320
AUTOFOCUS_SETTLE_MS=320
AUTOFOCUS_PEAK_DROP_STEPS=3
AUTOFOCUS_PEAK_DROP_RATIO=0.90
AUTOFOCUS_SAMPLES=2
AUTOFOCUS_CAPTURE_FPS=4
AUTOFOCUS_TIMEOUT_MS=60000
