AUTOFOCUS_SWEEP_ABOVE=150
AUTOFOCUS_SWEEP_MIN=9200
AUTOFOCUS_SWEEP_MAX=10100
AUTOFOCUS_PREGOTO_THRESHOLD=800
AUTOFOCUS_WARM_START_MAX_DELTA=800
